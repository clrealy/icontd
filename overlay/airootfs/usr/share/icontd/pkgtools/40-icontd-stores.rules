// block app stores (Discover, GNOME Software, anything using PackageKit or
// the flatpak system helper) for everyone except the icontd user + root.
polkit.addRule(function(action, subject) {
    if ((action.id.indexOf("org.freedesktop.packagekit.") == 0 ||
         action.id.indexOf("org.freedesktop.Flatpak.") == 0) &&
        subject.user != "icontd" && subject.user != "root") {
        return polkit.Result.NO;
    }
});
