// icontd fastfetch config — the red dot 🔴
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/icontd/fastfetch/icontd.txt",
    "color": { "1": "38;2;213;0;0" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;213;0;0", "title": "38;2;213;0;0" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    { "type": "command", "key": "Config", "text": "echo /etc/icontd/config.itd" },
    "break",
    "colors"
  ]
}
